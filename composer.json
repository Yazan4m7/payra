{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "solent/jordan-payroll-hr",
  "type": "project",
  "description": "Multi-tenant Jordan payroll and HR compliance SaaS",
  "require": {
    "php": "^8.2",
    "barryvdh/laravel-dompdf": "^3.0",
    "brick/math": "^0.12|^0.13|^0.14",
    "laravel/framework": "^12.65",
    "laravel/tinker": "^2.9",
    "livewire/livewire": "^3.0",
    "stancl/tenancy": "^3.9"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"],
    "test": "@php artisan test"
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true,
  "license": ["proprietary"]
}
